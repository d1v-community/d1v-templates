{
  "type": "module",
  "sideEffects": false,
  "name": "d1v-taro-remix-flutter-auth-template",
  "private": true,
  "scripts": {
    "build": "remix vite:build && pnpm -C apps/app build:h5",
    "build:remix": "remix vite:build",
    "build:taro:h5": "pnpm -C apps/app build:h5",
    "build:taro:weapp": "pnpm -C apps/app build:weapp",
    "dev:remix": "remix vite:dev --port 5173 --strictPort",
    "dev": "remix vite:dev --port 5173 --strictPort",
    "dev:app:h5": "pnpm -C apps/app dev:h5",
    "dev:app:weapp": "pnpm -C apps/app dev:weapp",
    "lint": "eslint --ignore-path .gitignore --cache --cache-location ./node_modules/.cache/eslint .",
    "lint:fix": "npm run lint -- --fix",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "start": "NODE_ENV=production node --env-file=.env ./node_modules/@remix-run/serve/dist/cli.js ./build/server/index.js",
    "typecheck": "tsc --noEmit --pretty -p tsconfig.json && tsc --noEmit --pretty -p apps/app/tsconfig.json",
    "typecheck:watch": "tsc --noEmit --watch",
    "flutter:pub:get": "cd apps/flutter_app && flutter pub get",
    "flutter:analyze": "cd apps/flutter_app && flutter analyze",
    "db:migrate": "node scripts/migrate.mjs",
    "db:seed": "node scripts/seed.mjs"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.0.0",
    "@remix-run/node": "^2.17.4",
    "@remix-run/react": "^2.17.4",
    "@remix-run/serve": "^2.17.4",
    "drizzle-orm": "^0.45.2",
    "isbot": "^4.1.0",
    "jsonwebtoken": "^9.0.2",
    "pino": "^9.3.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "resend": "^4.8.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@remix-run/dev": "^2.17.4",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.19.39",
    "@types/react": "^18.3.28",
    "@types/react-dom": "^18.3.7",
    "@typescript-eslint/eslint-plugin": "^8.46.4",
    "@typescript-eslint/parser": "^8.46.4",
    "autoprefixer": "^10.5.0",
    "dotenv": "^16.6.1",
    "eslint": "^8.38.0",
    "eslint-import-resolver-typescript": "^3.6.1",
    "eslint-plugin-import": "^2.28.1",
    "eslint-plugin-jsx-a11y": "^6.7.1",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "postcss": "^8.5.10",
    "prettier": "^3.8.3",
    "tailwindcss": "^3.4.18",
    "typescript": "~5.9.3",
    "vite": "^5.4.21",
    "vite-tsconfig-paths": "^4.3.2"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
